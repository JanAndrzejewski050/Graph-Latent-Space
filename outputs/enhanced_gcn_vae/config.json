{
  "arch": "enhanced_gcn_vae",
  "train_data": "data/subset/train.pt",
  "val_data": "data/subset/val.pt",
  "test_data": "data/subset/test.pt",
  "max_nodes": 37,
  "node_features": 10,
  "use_onehot_only": true,
  "hidden_dim": 256,
  "latent_dim": 256,
  "num_encoder_layers": 4,
  "dropout": 0.1,
  "batch_size": 256,
  "epochs": 3,
  "learning_rate": 0.001,
  "weight_decay": 0.0,
  "beta_start": 0.0,
  "beta_end": 0.05,
  "beta_warmup_epochs": 10,
  "beta_cyclical": false,
  "grad_clip_norm": 1.0,
  "output_dir": "outputs",
  "save_every": 5,
  "eval_num_samples": 1000,
  "edge_threshold": 0.5,
  "use_multi_bond": true
}